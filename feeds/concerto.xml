    &lt;div class="field__label"&gt;Imagem de destaque&lt;/div&gt;
              &lt;div class="field__item"&gt;  &lt;img src="http://concerto.com.br/sites/default/files/w-chopin1jpg.jpg" width="900" height="583" alt="Mateusz Krzyżowski [Reprodução/ Instagram/ Kulturalny Namyslow]" typeof="foaf:Image" /&gt;

&lt;/div&gt;
          &lt;/div&gt;

